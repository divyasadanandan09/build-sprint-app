{
  "name": "build-sprint-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "convex dev",
    "deploy": "npx @convex-dev/static-hosting deploy --no-spa",
    "check": "tsc --noEmit -p convex/tsconfig.json && tsc --noEmit -p tsconfig.frontend.json",
    "test": "vitest run",
    "test:m2": "vitest run tests/m2.test.ts tests/drafting.integration.test.ts --reporter=verbose",
    "demo:m2": "M2_SHOW_EXCHANGE=1 vitest run tests/m2.test.ts --testNamePattern=\"sends a combined named-review\" --reporter=verbose",
    "test:m3": "vitest run --reporter=verbose",
    "demo:m3": "M3_SHOW_EXCHANGE=1 vitest run tests/m3.test.ts --testNamePattern=\"sends an eligible dev client\" --reporter=verbose",
    "test:m4": "vitest run --reporter=verbose",
    "demo:m4": "M4_SHOW_EXCHANGE=1 vitest run tests/m4.test.ts --testNamePattern=\"transcribes a forwarded Kannada\" --reporter=verbose",
    "test:m5": "vitest run --reporter=verbose",
    "demo:m5": "M5_SHOW_EXCHANGE=1 vitest run tests/m5.test.ts --testNamePattern=\"starts the posting timer\" --reporter=verbose",
    "build": "vite build",
    "dev:page": "vite",
    "deploy:dev": "convex dev --once && npx @convex-dev/static-hosting upload --build --no-spa",
    "test:landing": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@convex-dev/agent": "^0.7.4",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.8",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "ai": "^7.0.128",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "convex-test": "^0.0.60",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
